{
  "name": "imap-mail-mcp",
  "version": "1.0.1",
  "description": "Local MCP server for searching and reading Naver, Daum, and Kakao Mail over IMAP",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "imap-mail-mcp": "bin/cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MK013467/imap-mail-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/MK013467/imap-mail-mcp/issues"
  },
  "homepage": "https://github.com/MK013467/imap-mail-mcp#readme",
  "scripts": {
    "setup": "node bin/cli.mjs setup",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "mcp:dev": "tsx watch src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:local": "node scripts/setup.mjs",
    "pretest": "npm run build"
  },
  "author": "Minsok Kwon",
  "license": "MIT",
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.6.2",
    "dev": "tsx watch src/index.ts",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^18.0.1",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "zod": "^4.6.5"
  },
  "files": [
    "bin/",
    "dist/",
    "scripts/",
    "skills/"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "imap",
    "email",
    "mail",
    "naver",
    "daum",
    "kakao",
    "codex",
    "claude-code"
  ],
  "engines": {
    "node": ">=20"
  }
}
